ACTUAL_MULTIUSER=true

# Pocket ID supports multiple redirect URIs per client, so this reuses the
# same client as actual-budget rather than registering a separate one — just
# add https://budgetkay.thegarden/openid/callback as an extra redirect URI
# on that existing client (alongside budget.thegarden's) and copy its
# client_id/secret here too.
ACTUAL_OPENID_DISCOVERY_URL=https://auth.thegarden/.well-known/openid-configuration
ACTUAL_OPENID_CLIENT_ID=
ACTUAL_OPENID_CLIENT_SECRET=
ACTUAL_OPENID_SERVER_HOSTNAME=https://budgetkay.thegarden

ACTUAL_USER_CREATION_MODE=manual
