ACTUAL_MULTIUSER=true

# From Pocket ID: create an OIDC client (redirect URI https://budget.thegarden/openid/callback)
ACTUAL_OPENID_DISCOVERY_URL=https://auth.thegarden/.well-known/openid-configuration
ACTUAL_OPENID_CLIENT_ID=
ACTUAL_OPENID_CLIENT_SECRET=
ACTUAL_OPENID_SERVER_HOSTNAME=https://budget.thegarden

# manual (default) = admin pre-adds each user in the User Directory before they can log in
# login = any successful OpenID login auto-provisions an Actual account
ACTUAL_USER_CREATION_MODE=manual
